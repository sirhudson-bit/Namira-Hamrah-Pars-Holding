// Namira Holding — corporate website + CMS data model.
// SQLite for zero-config local runs; the schema is portable to PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Key/value site settings (contact info, social links, SEO defaults, toggles).
model Setting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

/// Back-office operator. Seeded from prisma/seed.ts.
model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("admin") // admin | editor
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

/// Long-form content pages: legal documents, about, innovation intro, etc.
model Page {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  /// Small label above the page title ("kicker").
  eyebrow       String?
  subtitle      String?
  /// Markdown body rendered by the shared renderer.
  body          String   @default("")
  seoTitle      String?
  seoDesc       String?
  /// Hero backdrop for this page only (falls back to the global page_hero_bg).
  image         String   @default("")
  /// CSS background-position for the hero image (center/top/bottom/left/right).
  imagePosition String   @default("center")
  published     Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

/// A widget placed on a public page from /admin/layout.
///
/// `data` is a JSON object whose keys depend on `type`; see src/lib/blocks.ts
/// for the schema. Keeping it in one column means a new widget type needs no
/// migration, while the admin form is still generated from a typed definition.
model PageBlock {
  id        String   @id @default(cuid())
  /// Route key: "home", "about", "business-groups", ...
  pageSlug  String
  /// heading | text | image | split | cards | stats | cta | gallery | video | spacer
  type      String
  data      String   @default("{}")
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([pageSlug, sortOrder])
}

/// A site navigation location (header, footer column, ...). Items are edited
/// in /admin/menus; the public header/footer falls back to the built-in nav
/// when a location has no rows yet.
model Menu {
  id        String     @id @default(cuid())
  key       String     @unique
  title     String
  sortOrder Int        @default(0)
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id           String     @id @default(cuid())
  menuId       String
  parentId     String?
  label        String
  href         String
  description  String     @default("")
  sortOrder    Int        @default(0)
  visible      Boolean    @default(true)
  openInNewTab Boolean    @default(false)
  updatedAt    DateTime   @updatedAt
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuItemTree")

  @@index([menuId, parentId, sortOrder])
}

/// Home-page banner (slider slide), managed from /admin/home.
model HomeBanner {
  id            String   @id @default(cuid())
  title         String
  subtitle      String   @default("")
  image         String
  imageAlt      String   @default("")
  /// CSS object-position for the slide image.
  imagePosition String   @default("center")
  href          String   @default("")
  ctaLabel      String   @default("")
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

/// The five business groups under the holding.
model BusinessGroup {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  tagline       String
  description   String
  icon          String   @default("Boxes")
  color         String   @default("#0F7C71")
  highlights    String   @default("") // newline-separated bullet points
  /// Optional call-to-action on the group card, configurable per group from the
  /// admin panel. When `ctaUrl` is empty the card falls back to the internal
  /// detail page.
  ctaLabel      String   @default("")
  ctaUrl        String   @default("")
  /// Cover image path (media library). Empty = icon-only card.
  image         String   @default("")
  imageAlt      String   @default("")
  imagePosition String   @default("center")
  sortOrder     Int      @default(0)
  published     Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

/// Sales channels: online stores, physical store, corporate sales.
model Store {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  /// B2C | B2B | PHYSICAL | CORPORATE
  kind          String   @default("B2C")
  description   String
  url           String?
  phone         String?
  address       String?
  email         String?
  /// Cover image path (media library).
  image         String   @default("")
  imagePosition String   @default("center")
  sortOrder     Int      @default(0)
  published     Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

/// After-sales and support service entries.
model ServiceItem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  icon        String  @default("Sparkles")
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

/// Organizational units listed under /units.
model OrgUnit {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// offline | online | commercial | finance | hr | marketing | support
  kind        String  @default("offline")
  description String
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model NewsPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  body          String   @default("")
  category      String   @default("خبر")
  /// Cover image path (media library) shown on cards and the article header.
  image         String   @default("")
  imagePosition String   @default("center")
  published     Boolean  @default(false)
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  body          String   @default("")
  category      String   @default("مقاله")
  author        String   @default("تیم نامیرا")
  /// Cover image path (media library) shown on cards and the article header.
  image         String   @default("")
  imagePosition String   @default("center")
  published     Boolean  @default(false)
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JobOpening {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  department    String
  location      String   @default("تهران")
  type          String   @default("تمام‌وقت")
  description   String
  requirements  String   @default("")
  /// Image path (media library) shown beside the opening.
  image         String   @default("")
  imagePosition String   @default("center")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model JobApplication {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String
  position         String
  resumeName       String?
  resumePath       String?
  coverLetter      String?
  dataConsent      Boolean  @default(false)
  retentionConsent Boolean  @default(false)
  status           String   @default("new") // new | review | archived
  createdAt        DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  consent   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  path      String
  mime      String
  size      Int
  alt       String   @default("")
  /// Optional caption/title, editable from /admin/media.
  title     String   @default("")
  /// Shown in the public gallery on /media.
  inGallery Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Namira Labs innovation projects.
model InnovationProject {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  status      String  @default("در حال توسعه")
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model TeamMember {
  id        String  @id @default(cuid())
  name      String
  role      String
  bio       String  @default("")
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Milestone {
  id          String @id @default(cuid())
  year        String
  title       String
  description String
  sortOrder   Int    @default(0)
}
