# SQLite database used by Prisma (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Session cookie signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET="change-me-to-a-32-byte-base64-secret"

# Public site URL, used for canonical links and metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Google Analytics measurement id. Loaded ONLY after analytics consent.
NEXT_PUBLIC_GA_ID=""

# Local verification only. The form/login rate limiters are in-memory, so
# repeated runs of `npm run verify` would throttle themselves. Setting this to
# "1" disables them for a locally started server. NEVER set it in production.
RATE_LIMIT_DISABLED=""
